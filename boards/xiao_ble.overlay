/*
 * SPDX-License-Identifier: Apache-2.0
 * ST7789 initialization values adapted from Zephyr's
 * st7789v_waveshare_240x240.overlay:
 * Copyright (c) 2019 Jan Van Winkel <jan.van_winkel@dxplore.eu>
 * Copyright (c) 2019 PHYTEC Messtechnik GmbH
 * SPI mode 3; no CS line (verified on the prototype panel). This bus must be dedicated to this panel.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
    chosen { zephyr,display = &satellite_lcd; };
    lcd_bus {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi2>;
        dc-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;
        satellite_lcd: st7789v@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            mipi-cpol;
            mipi-cpha;
            mipi-max-frequency = <4000000>;
            width = <240>; height = <240>;
            x-offset = <0>; y-offset = <0>;
            vcom = <0x19>; gctrl = <0x35>;
            vrhs = <0x12>; vdvs = <0x20>;
            mdac = <0x00>; gamma = <0x01>;
            colmod = <0x05>; lcm = <0x2c>;
            porch-param = [0c 0c 00 33 33];
            cmd2en-param = [5a 69 02 01];
            pwctrl1-param = [a4 a1];
            pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
            nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
            ram-param = [00 f8]; /* LVGL native little-endian RGB565 */ rgb-param = [cd 08 14];
        };
    };
};
&pinctrl {
    satellite_spi_default: satellite_spi_default {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                         <NRF_PSEL(SPIM_MOSI, 1, 15)>; };
    };
    satellite_spi_sleep: satellite_spi_sleep {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                         <NRF_PSEL(SPIM_MOSI, 1, 15)>;
                 low-power-enable; };
    };
};
&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&satellite_spi_default>;
    pinctrl-1 = <&satellite_spi_sleep>;
    pinctrl-names = "default", "sleep";
    /delete-property/ cs-gpios;
};
&uart0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&qspi { status = "disabled"; };
